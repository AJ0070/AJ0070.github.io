---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
const resumePDF = "/resume-1.pdf";
---

<Layout title={`Resume | ${SITE.title}`}>
  <Header activeNav="resume" />

  <main
    id="main-content"
    style="display: flex; justify-content: center; align-items: center; flex-direction: column; padding: 2rem;"
  >
    <h1>Jash's Resume</h1>
    <p class="my-6 text-lg">Resume coming soon!</p>
  </main>
  <Footer />
</Layout>

<style>
  @media (max-width: 1000px) {
    iframe {
      width: 100% !important;
    }
  }
</style>
